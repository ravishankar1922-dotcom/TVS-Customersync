# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/balancesync
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/balancesync
MONGO_URI=mongodb://127.0.0.1:27017/balancesync

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate strong random values in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
HMAC_SECRET=change-this-to-a-different-long-random-string
ADMIN_EMAIL=admin@tvsmobility.com
ADMIN_PASSWORD=ChangeMe@123
TOKEN_EXPIRY_HOURS=72

# ── Cycle / company context ──────────────────────────────────────────────
CYCLE_ID=TSL-MAR-2026
COMPANY=TSL
AS_OF_DATE=31-Mar-2026

# ── Outbound email (SMTP) ─────────────────────────────────────────────────
# Works with any SMTP provider: SendGrid, SES, Gmail (app password), Office365, etc.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
MAIL_FROM="TVS Mobility AR Team <ar.confirmation@tvsmobility.com>"

# ── File storage ──────────────────────────────────────────────────────────
# Local disk by default. For production, point this at a mounted volume
# or swap the upload logic in routes/confirmations.js + routes/ledger.js
# for an S3/Azure Blob SDK call (see DEPLOYMENT_GUIDE.md).
UPLOAD_ROOT=./storage
